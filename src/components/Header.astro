---
import { site } from '../site.config';
import { isCurrent, url } from '../lib/url';
import { pad2 } from '../lib/handbook';

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href={url('/')} aria-label={`${site.name} 首页`}>
      <!-- 一张海獭的脸：圆脑袋，贴在两边的小耳朵，又宽又大的鼻子 -->
      <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
        <g fill="currentColor">
          <circle cx="4.7" cy="11.4" r="2.5"></circle>
          <circle cx="27.3" cy="11.4" r="2.5"></circle>
          <ellipse cx="16" cy="16.4" rx="12.8" ry="11.8"></ellipse>
        </g>
        <g fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round">
          <path d="M3.6 19.2.8 18.7M3.9 21.6 1.3 22.7M28.4 19.2l2.8-.5M28.1 21.6l2.6 1.1"></path>
        </g>
        <g class="hole">
          <circle cx="10.5" cy="14.4" r="1.35"></circle>
          <circle cx="21.5" cy="14.4" r="1.35"></circle>
          <ellipse cx="16" cy="18" rx="3.5" ry="2.3"></ellipse>
        </g>
        <path
          class="hole"
          fill="none"
          stroke="var(--paper)"
          stroke-width="1.1"
          stroke-linecap="round"
          d="M16 20.4v1.5M16 21.9c-.9 1.5-2.9 1.5-3.7.1M16 21.9c.9 1.5 2.9 1.5 3.7.1"
          style="fill:none"></path>
      </svg>
      <span class="brand-name">{site.name}</span>
      <span class="brand-sub">{site.nameZh}</span>
    </a>

    <nav class="nav" aria-label="主导航">
      {
        site.nav.map((item, i) => (
          <a href={url(item.href)} aria-current={isCurrent(path, item.href) ? 'page' : undefined}>
            <span class="nav-i">{pad2(i + 1)}</span>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-tools">
      <button class="tool" type="button" data-theme-toggle aria-label="切换明暗主题" title="切换明暗主题">
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
          <path d="M8 1.75a6.25 6.25 0 0 1 0 12.5z" fill="currentColor"></path>
        </svg>
      </button>
      <a class="tool" href={site.repo} rel="noopener" aria-label="GitHub 仓库" title="GitHub">
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path
            fill="currentColor"
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</header>
